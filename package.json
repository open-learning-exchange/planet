{
  "name": "planet",
  "license": "AGPL-3.0",
  "version": "0.24.49",
  "myplanet": {
    "latest": "v0.69.36",
    "min": "v0.65.55"
  },
  "scripts": {
    "ng": "ng",
    "ng-high-memory": "node --max_old_space_size=4096 ./node_modules/@angular/cli/bin/ng",
    "start": "ng serve",
    "dev": "bash scripts/dev-env.sh && ng serve --configuration dev",
    "dev:locale": "bash -c ': \"${npm_config_locale:?Set a locale with --locale=spa}\"; bash scripts/dev-env.sh && ng serve --build-target planet-app:build:dev,$npm_config_locale \"$@\"' --",
    "build": "npm run ng-high-memory -- build --configuration production",
    "i18n:extract": "ng extract-i18n --output-path src/i18n && npm run i18n:normalize",
    "i18n:normalize": "node scripts/i18n-normalize.mjs src/i18n/messages*.xlf",
    "i18n:check": "ng extract-i18n --output-path /tmp/planet-i18n-check && node scripts/i18n-normalize.mjs /tmp/planet-i18n-check/messages.xlf",
    "test": "ng test",
    "htmlhint": "./node_modules/htmlhint-ng2/bin/htmlhint --config .htmlhintrc",
    "sass-lint": "./node_modules/sass-lint/bin/sass-lint.js -c ./sass-lint.yml -v -q",
    "lint": "ng lint planet-app",
    "lint-all": "npm run sass-lint && ng lint planet-app --type-check && npm run htmlhint",
    "install-hooks": "cp -a git-hooks/. .git/hooks/",
    "webdriver-set-version": "webdriver-manager update --standalone false --gecko false --versions.chrome 2.37",
    "starthub-true": "echo \"true\" > /srv/starthub",
    "starthub-false": "echo \"false\" > /srv/starthub"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "21.2.22",
    "@angular/cdk": "21.2.14",
    "@angular/common": "21.2.22",
    "@angular/compiler": "21.2.22",
    "@angular/core": "21.2.22",
    "@angular/forms": "21.2.22",
    "@angular/localize": "21.2.22",
    "@angular/material": "21.2.14",
    "@angular/platform-browser": "21.2.22",
    "@angular/router": "21.2.22",
    "@angular/service-worker": "21.2.22",
    "@covalent/markdown": "^11.19.5",
    "@covalent/text-editor": "^11.19.5",
    "@fullcalendar/angular": "^6.1.21",
    "@fullcalendar/core": "^6.1.21",
    "@fullcalendar/daygrid": "^6.1.21",
    "@fullcalendar/interaction": "^6.1.21",
    "chart.js": "^3.9.1",
    "events": "^3.3.0",
    "export-to-csv": "^0.2.1",
    "html-to-pdfmake": "^1.2.0",
    "jszip": "^3.2.2",
    "marked": "4.2.5",
    "material-design-icons": "^3.0.1",
    "mime": "4.0.0",
    "ngx-image-cropper": "^8.1.1",
    "papaparse": "^5.5.3",
    "pdfmake": "^0.3.6",
    "pouchdb": "^7.1.1",
    "pouchdb-authentication": "^1.1.3",
    "pouchdb-find": "^7.1.1",
    "rxjs": "^7.8.2",
    "showdown": "2.1.0",
    "tslib": "^2.0.0",
    "zone.js": "~0.15.1"
  },
  "devDependencies": {
    "@angular-eslint/builder": "21.4.0",
    "@angular-eslint/eslint-plugin": "21.4.0",
    "@angular-eslint/eslint-plugin-template": "21.4.0",
    "@angular-eslint/schematics": "21.4.0",
    "@angular-eslint/template-parser": "21.4.0",
    "@angular/build": "^21.2.23",
    "@angular/cli": "21.2.23",
    "@angular/compiler-cli": "21.2.22",
    "@angular/language-service": "21.2.22",
    "@eslint/compat": "^1.4.1",
    "@eslint/eslintrc": "^3.3.5",
    "@eslint/js": "^9.39.4",
    "@fortawesome/fontawesome-free": "^5.13.0",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^22.0.0",
    "@types/papaparse": "^5.3.16",
    "@types/pouchdb": "^6.4.0",
    "@types/pouchdb-find": "^6.3.4",
    "@typescript-eslint/eslint-plugin": "^8.57.1",
    "@typescript-eslint/parser": "^8.57.1",
    "@typescript-eslint/types": "^8.69.0",
    "@typescript-eslint/utils": "^8.69.0",
    "eslint": "^9.39.4",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-jsdoc": "^46.10.1",
    "eslint-plugin-prefer-arrow": "^1.2.3",
    "htmlhint-ng2": "0.0.13",
    "jsdom": "^26.1.0",
    "sass-lint": "^1.13.1",
    "ts-node": "~8.5.4",
    "typescript": "~5.9.3",
    "vite": "^7.3.6",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "@typescript-eslint/visitor-keys": {
      "eslint-visitor-keys": "4.2.1"
    },
    "@covalent/markdown": {
      "@angular/core": "$@angular/core",
      "@angular/common": "$@angular/common",
      "@angular/platform-browser": "$@angular/platform-browser"
    },
    "@covalent/text-editor": {
      "@angular/core": "$@angular/core",
      "@angular/common": "$@angular/common"
    },
    "vitest": {
      "vite": "$vite"
    }
  }
}
