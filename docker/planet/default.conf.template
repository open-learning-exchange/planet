upstream couchdb {
  server couchdb:5984;
  keepalive 16;
}

# The parent's AuthSession is stored as ParentSession so it can't collide with the local one
map $cookie_ParentSession $parent_cookie {
  ''      '';
  default 'AuthSession=$cookie_ParentSession';
}

# Only the parent's own session cookie, keeping its lifetime so it survives a browser restart like the local one
map $upstream_http_set_cookie $parent_set_cookie {
  ~^AuthSession= 'ParentSession=$upstream_cookie_AuthSession; Path=/parent/$parent_host/; HttpOnly; SameSite=Strict$parent_max_age';
  default        '';
}

map $upstream_http_set_cookie $parent_max_age {
  ~Max-Age=(?<parent_max_age_value>[0-9]+) '; Max-Age=$parent_max_age_value';
  default                                  '';
}

# Read from the raw $request_uri, which the browser scopes the cookie by: the decoded $uri would let
# /parent/<host>/..%2F<other>/ reach another host, and would decode ids and attachment names
map $request_uri $parent_host {
  ~^/parent/(?<parent_name>[a-z0-9.-]+(:[0-9]+)?)/ $parent_name;
}

map $request_uri $parent_request_uri {
  ~^/parent/[a-z0-9.-]+(:[0-9]+)?(?<parent_rest>/.*)$ $parent_rest;
}

# Logout clears the cookie here too, so it goes even when the gateway or the parent can't be reached
map "$request_method $parent_request_uri" $parent_logout_cookie {
  "~^DELETE /db/_session(\?|$)" 'ParentSession=; Path=/parent/$parent_host/; Max-Age=0';
  default                        '';
}

server {

  listen 80;

  sendfile on;

  default_type application/octet-stream;


  gzip on;
  gzip_http_version 1.1;
  gzip_disable      "MSIE [1-6]\.";
  gzip_min_length   1100;
  gzip_vary         on;
  gzip_proxied      expired no-cache no-store private auth;
  gzip_types        text/plain text/css application/json application/javascript application/x-javascript text/xml application/xml application/xml+rss text/javascript;
  gzip_comp_level   9;

  root /usr/share/nginx/html;

  location /eng {
    autoindex on;
    try_files $uri$args $uri$args/ /eng/index.html =404;
  }

  location /ara {
    autoindex on;
    try_files $uri$args $uri$args/ /ara/index.html =404;
  }

  location /spa {
    autoindex on;
    try_files $uri$args $uri$args/ /spa/index.html =404;
  }

  location /nep {
    autoindex on;
    try_files $uri$args $uri$args/ /nep/index.html =404;
  }

  location /fra {
    autoindex on;
    try_files $uri$args $uri$args/ /fra/index.html =404;
  }

  location /som {
    autoindex on;
    try_files $uri$args $uri$args/ /som/index.html =404;
  }

  location / {
    try_files $uri$args /$DEFAULT_LANGUAGE/$uri$args /$DEFAULT_LANGUAGE/index.html /eng/$uri$args /eng/index.html =404;
  }

  location = /latest {
    include fastcgi_params;
    fastcgi_param SCRIPT_FILENAME "$document_root/latest.sh";
    fastcgi_pass unix://run/fcgi.sock;
  }

  location = /time {
    include fastcgi_params;
    fastcgi_param SCRIPT_FILENAME "$document_root/time.sh";
    fastcgi_pass unix://run/fcgi.sock;
  }

  location = /upgrade {
    include fastcgi_params;

    if ($args ~ "v=(.{1,})$") {
      set $version $1;
    }

    if ($args !~ "v=(.{1,})$") {
      return 400;
    }

    fastcgi_read_timeout 900;
    fastcgi_param SCRIPT_FILENAME "$document_root/upgrade.sh";
    fastcgi_param PLANET_VERSION "$version";
    fastcgi_pass unix://run/fcgi.sock;
  }

  location = /updateyml {
    include fastcgi_params;

    if ($args ~ "u=(.{1,})$") {
      set $credentials $1;
    }

    if ($args !~ "u=(.{1,})$") {
      return 400;
    }

    fastcgi_param SCRIPT_FILENAME "$document_root/credentials.sh";
    fastcgi_param PLANET_CREDENTIALS "$credentials";
    fastcgi_pass unix://run/fcgi.sock;
  }

  location = /updateconf {
    include fastcgi_params;

    fastcgi_param SCRIPT_FILENAME "$document_root/credentials.sh";
    fastcgi_param PLANET_CREDENTIALS "$credentials";
    fastcgi_pass unix://run/fcgi.sock;
  }

  location = /version {
    add_header 'Access-Control-Allow-Origin' '*';
    add_header Last-Modified $date_gmt;
    add_header Cache-Control 'no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0';
    add_header Content-Type text/plain;
  }

  location = /versions {
    add_header 'Access-Control-Allow-Origin' '*';
    add_header Last-Modified $date_gmt;
    add_header Cache-Control 'no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0';
    add_header Content-Type text/plain;
  }

  location = /apkversion {
    add_header 'Access-Control-Allow-Origin' '*';
    add_header Last-Modified $date_gmt;
    add_header Cache-Control 'no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0';
    add_header Content-Type text/plain;
    try_files /fs/apkversion @empty;
  }

  location /_session {
    proxy_pass       http://couchdb/_session;
    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header Host      $host;
    proxy_set_header X-Real-IP $remote_addr;
    client_max_body_size 1024M;
  }

  location /ml/ {
    proxy_pass       http://chatapi:5000/;
    proxy_http_version 1.1;
    # $http_host keeps the port, which the gateway compares with the browser's Origin
    proxy_set_header Host      $http_host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
    client_max_body_size 1024M;
    # Above the gateway's 120 s AI provider deadline
    proxy_read_timeout 150s;
  }

  location /api/ {
    proxy_pass       http://chatapi:5000/;
    proxy_set_header Host      $http_host;
    proxy_set_header X-Real-IP $remote_addr;
    client_max_body_size 1024M;
  }

  location /db/ {
    proxy_pass       http://couchdb/;
    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header Host      $host;
    proxy_set_header X-Real-IP $remote_addr;
    # a slow client holds CouchDB back instead of spooling the response to disk
    proxy_max_temp_file_size 0;
    client_max_body_size 1024M;
  }

  # Browsers drop the parent's cookie cross-site; through here it is first-party
  location /parent/ {
    if ($parent_host = '') {
      return 404;
    }
    auth_request /parent-check;
    resolver 127.0.0.11 ipv6=off;
    proxy_pass https://$parent_host$parent_request_uri;
    proxy_ssl_server_name on;
    proxy_ssl_verify on;
    proxy_ssl_verify_depth 3;
    proxy_ssl_trusted_certificate /etc/ssl/certs/ca-certificates.crt;
    proxy_set_header Cookie $parent_cookie;
    proxy_set_header Authorization "";
    proxy_hide_header Set-Cookie;
    add_header Set-Cookie $parent_set_cookie;
    add_header Set-Cookie $parent_logout_cookie always;
    # The parent's HTML would otherwise run on this origin with the local session
    add_header Content-Security-Policy "sandbox" always;
    proxy_hide_header Access-Control-Allow-Origin;
    proxy_hide_header Access-Control-Allow-Credentials;
    proxy_max_temp_file_size 0;
    client_max_body_size 1024M;
  }

  # The gateway answers 204 only for this planet's configured parent
  location = /parent-check {
    internal;
    proxy_pass http://chatapi:5000/parent-check;
    proxy_method GET;
    proxy_pass_request_body off;
    proxy_pass_request_headers off;
    proxy_set_header Content-Length "";
    proxy_set_header X-Parent-Host $parent_host;
  }

  location = /upgrade/planetapk {
    include fastcgi_params;
    fastcgi_read_timeout 900;
    fastcgi_param SCRIPT_FILENAME "$document_root/upgrade_planetapk.sh";
    fastcgi_pass unix://run/fcgi.sock;
  }

  location = /upgrade/fromnation/planetapk {
    include fastcgi_params;
    fastcgi_param SCRIPT_FILENAME "$document_root/upgrade_planetapk_fromnation.sh";
    fastcgi_pass unix://run/fcgi.sock;
  }

  location = /healthaccess {
    include fastcgi_params;

    if ($args ~ "p=(.{1,})$") {
      set $credentials $1;
    }

    if ($args !~ "p=(.{1,})$") {
      return 400;
    }

    fastcgi_param SCRIPT_FILENAME "$document_root/set_health_security.sh";
    fastcgi_param SATELLITE_CREDENTIALS "$credentials";
    fastcgi_pass unix://run/fcgi.sock;
  }

  location = /storage {
    include fastcgi_params;
    fastcgi_param SCRIPT_FILENAME "$document_root/storage.sh";
    fastcgi_pass unix://run/fcgi.sock;
  }

  location @empty {
    return 200 '';
  }
}
