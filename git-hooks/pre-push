#!/bin/bash

# Pre-push hook: lints the current Planet and gateway working trees before
# allowing a push. CI remains the authoritative check for pushed commits.

pass=true
RED='\033[1;31m'
GREEN='\033[0;32m'
NC='\033[0m'

repo_root=$(git rev-parse --show-toplevel) || exit 1

run_lint() {
  local dir=$1
  local label=$2
  local output

  echo "Running $label lint"
  if ! output=$(cd "$repo_root/$dir" && npm run lint 2>&1); then
    printf "${RED}%s lint failed.${NC}\n" "$label"
    echo "$output"
    pass=false
  else
    printf "${GREEN}%s lint passed.${NC}\n" "$label"
  fi
}

run_lint "." "planet"
run_lint "gateway" "gateway"

if $pass; then
  exit 0
fi

exit 1
